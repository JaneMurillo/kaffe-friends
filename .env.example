# Copia este archivo como .env para cambiar la configuración (es opcional).

# Puerto del servidor local
PORT=5050

# Dirección de escucha. 127.0.0.1 = solo esta computadora (recomendado: la app no tiene inicio de sesión).
HOST=127.0.0.1

# ---- Acceso desde tu teléfono ----
# Para abrir la guía desde el teléfono (misma red Wi-Fi), usa HOST=0.0.0.0 y define una contraseña.
# Sin contraseña, el servidor se niega a iniciar fuera de 127.0.0.1.
# APP_PASSWORD=escribe-una-contraseña-larga

# ---- Enlaces de Google Maps ----
# Sin clave, solo se usan los datos que trae el enlace. Con clave, Places API (New) completa lo demás.
# Lee "Enlaces de Google Maps" en el README antes de activarla: tiene costo y condiciones de uso.
# GOOGLE_MAPS_API_KEY=

# Carpeta de datos (base de datos, fotografías y respaldos). Relativa a la raíz del proyecto o absoluta.
DATA_DIR=data
